{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@echidna-claw/config": [
        "packages/config/src/index.ts",
        "packages/config/dist/index.d.ts"
      ],
      "@echidna-claw/config/browser": [
        "packages/config/src/browser.ts",
        "packages/config/dist/browser.d.ts"
      ],
      "@echidna-claw/contracts": [
        "packages/contracts/src/index.ts",
        "packages/contracts/dist/index.d.ts"
      ],
      "@echidna-claw/domain": [
        "packages/domain/src/index.ts",
        "packages/domain/dist/index.d.ts"
      ],
      "@echidna-claw/hands-runtime": [
        "packages/hands-runtime/src/index.ts",
        "packages/hands-runtime/dist/index.d.ts"
      ],
      "@echidna-claw/observability": [
        "packages/observability/src/index.ts",
        "packages/observability/dist/index.d.ts"
      ],
      "@echidna-claw/persistence": [
        "packages/persistence/src/index.ts",
        "packages/persistence/dist/index.d.ts"
      ],
      "@echidna-claw/prompting": [
        "packages/prompting/src/index.ts",
        "packages/prompting/dist/index.d.ts"
      ],
      "@echidna-claw/testing": [
        "packages/testing/src/index.ts",
        "packages/testing/dist/index.d.ts"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "node"
    ]
  }
}
