{
  "version": "1",
  "models": {
    "defaultModel": "gpt-5.4-mini",
    "pricing": [
      {
        "model": "gpt-5.4-mini",
        "provider": "azure-foundry",
        "effectiveAt": "2026-04-12T00:00:00.000Z",
        "unit": "1m_tokens",
        "inputUsd": 0.2,
        "outputUsd": 0.8
      }
    ]
  },
  "agents": {
    "factoryProfile": {
      "version": "factory-v1",
      "defaultTimeZone": "Australia/Sydney",
      "initialResponsibilitiesSummary": "Start from the shared factory-default operator profile until scheduling and Telegram handoff are completed in later steps."
    }
  },
  "approvals": {
    "policy": {
      "categories": [
        {
          "id": "external_write",
          "displayName": "Write to an external system",
          "stepUpRequired": false,
          "defaultExpiryMinutes": 60
        },
        {
          "id": "send",
          "displayName": "Send through an external service",
          "stepUpRequired": true,
          "defaultExpiryMinutes": 60
        },
        {
          "id": "delete",
          "displayName": "Delete or remove data",
          "stepUpRequired": true,
          "defaultExpiryMinutes": 30
        },
        {
          "id": "purchase",
          "displayName": "Spend money or place an order",
          "stepUpRequired": true,
          "defaultExpiryMinutes": 15
        },
        {
          "id": "credential_change",
          "displayName": "Change a stored credential",
          "stepUpRequired": true,
          "defaultExpiryMinutes": 30
        },
        {
          "id": "bulk_update",
          "displayName": "Apply a bulk update",
          "stepUpRequired": true,
          "defaultExpiryMinutes": 30
        },
        {
          "id": "other",
          "displayName": "Other guarded action",
          "stepUpRequired": false,
          "defaultExpiryMinutes": 60
        }
      ]
    }
  },
  "credentials": {
    "services": [
      {
        "provider": "telegram",
        "alias": "telegram-bot-token",
        "displayName": "Telegram bot token",
        "reasonTemplate": "Used to send and acknowledge Telegram messages for this agent.",
        "storageNotice": "It will be stored encrypted for this agent until you revoke or replace it.",
        "accessPolicyRef": "telegram.bot",
        "sandboxBindings": []
      },
      {
        "provider": "github",
        "alias": "github-token",
        "displayName": "GitHub personal access token",
        "reasonTemplate": "Used when this agent needs to authenticate to GitHub APIs or repositories.",
        "storageNotice": "It will be stored encrypted for this agent until you revoke or replace it.",
        "accessPolicyRef": "github.api",
        "sandboxBindings": [
          {
            "exposure": "env",
            "targetName": "GITHUB_TOKEN"
          }
        ]
      }
    ]
  },
  "memory": {
    "storeNamePrefix": "echidna-agent",
    "retrieval": {
      "maxItems": 6,
      "maxCharsPerItem": 400
    },
    "writes": {
      "allowTriggerKinds": [
        "trusted_messages"
      ]
    },
    "policy": {
      "remember": [
        "preferences",
        "standing_instructions",
        "durable_facts",
        "recurring_patterns",
        "agent_guidance"
      ],
      "exclude": [
        "operational_scratch",
        "active_task_state",
        "queue_state",
        "approvals",
        "credentials",
        "run_journal_detail"
      ]
    }
  },
  "sandbox": {
    "defaultPolicy": "standard",
    "defaultPackageAllowlist": "default-runtime-pnpm",
    "policies": [
      {
        "name": "standard",
        "description": "Default v1 sandbox policy for trusted shell execution under bounded workspace rules.",
        "allowFilesystemWriteUnder": [
          "/work",
          "/artifacts",
          "/home"
        ],
        "blockFilesystemPaths": [
          "/work/.git",
          "/home/.ssh",
          "/home/.azure",
          "/proc",
          "/sys"
        ],
        "allowOutboundHosts": [
          "api.telegram.org",
          "files.pythonhosted.org",
          "github.com",
          "management.azure.com",
          "login.microsoftonline.com",
          "pypi.org",
          "raw.githubusercontent.com",
          "registry.npmjs.org",
          "*.openai.azure.com"
        ],
        "blockOutboundHosts": [
          "127.0.0.1",
          "169.254.169.254",
          "::1",
          "host.docker.internal",
          "kubernetes.default.svc",
          "localhost",
          "metadata.azure.internal"
        ],
        "allowCommands": [
          "az",
          "bash",
          "cat",
          "cd",
          "curl",
          "echo",
          "git",
          "ls",
          "mkdir",
          "node",
          "npm",
          "npx",
          "pnpm",
          "pwd",
          "pwsh",
          "python",
          "python3",
          "sh"
        ],
        "resourceLimits": {
          "defaultTimeoutMs": 10000,
          "maxTimeoutMs": 60000,
          "maxOutputBytes": 32768,
          "maxMemoryMb": 1024,
          "maxCpuSeconds": 30
        }
      }
    ],
    "packageAllowlists": [
      {
        "name": "default-runtime-npm",
        "packageManager": "npm",
        "packages": [
          "@azure/*",
          "dotenv",
          "fastify",
          "react",
          "react-dom",
          "tsx",
          "vitest",
          "zod"
        ]
      },
      {
        "name": "default-runtime-pnpm",
        "packageManager": "pnpm",
        "packages": [
          "@azure/*",
          "dotenv",
          "fastify",
          "react",
          "react-dom",
          "tsx",
          "vitest",
          "zod"
        ]
      },
      {
        "name": "default-runtime-pip",
        "packageManager": "pip",
        "packages": [
          "pydantic",
          "pytest",
          "requests"
        ]
      }
    ]
  },
  "capabilities": {
    "registry": [
      {
        "id": "telegram.messaging",
        "name": "Telegram direct messaging",
        "description": "Sends and receives Telegram direct-message traffic for agent-bound channel identities.",
        "category": "channel"
      },
      {
        "id": "sandbox.shell",
        "name": "Sandbox shell execution",
        "description": "Runs terminal-like commands inside the sandbox service under repository-defined policy guardrails.",
        "category": "tool"
      }
    ]
  }
}
