# Core runtime selection
NODE_ENV=development
LOG_LEVEL=info
ECHIDNA_RUNTIME_MODE=local-minimal

# Local process loop
ECHIDNA_WEB_PUBLIC_BASE_URL=http://127.0.0.1:5173
ECHIDNA_API_HOST=127.0.0.1
ECHIDNA_API_PORT=3001
ECHIDNA_API_PUBLIC_BASE_URL=
ECHIDNA_SANDBOX_HOST=127.0.0.1
ECHIDNA_SANDBOX_PORT=3002
ECHIDNA_INTERNAL_RUNTIME_AUTH_TOKEN=local-internal-runtime-token
ECHIDNA_HEAD_DEBOUNCE_WINDOW_MS=750
ECHIDNA_HANDS_BASE_URL=http://127.0.0.1:3003
ECHIDNA_HANDS_HEARTBEAT_INTERVAL_MS=30000
ECHIDNA_HANDS_HOST=127.0.0.1
ECHIDNA_HANDS_LIVENESS_FILE=
ECHIDNA_HANDS_PORT=3003
ECHIDNA_HANDS_START_RUN_PAYLOAD=
ECHIDNA_HANDS_WORKER_INSTANCE_ID=
ECHIDNA_SANDBOX_BASE_URL=http://127.0.0.1:3002
ECHIDNA_SANDBOX_WORKSPACE_ROOT=
ECHIDNA_SANDBOX_CLEANUP_TTL_MS=3600000
ECHIDNA_SANDBOX_DEFAULT_TIMEOUT_MS=10000
ECHIDNA_SANDBOX_MAX_TIMEOUT_MS=60000
ECHIDNA_SANDBOX_DEFAULT_OUTPUT_LIMIT_BYTES=32768
ECHIDNA_SANDBOX_STARTUP_CLEANUP_ENABLED=true
ECHIDNA_FOUNDRY_DEFAULT_DEPLOYMENT_NAME=
ECHIDNA_FOUNDRY_MEMORY_CHAT_DEPLOYMENT_NAME=
ECHIDNA_FOUNDRY_MEMORY_EMBEDDING_DEPLOYMENT_NAME=
ECHIDNA_TELEGRAM_API_BASE_URL=https://api.telegram.org
ECHIDNA_TELEGRAM_REQUEST_TIMEOUT_MS=10000

# Browser build-time settings
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_APP_BASE_URL=http://127.0.0.1:5173
VITE_APP_TITLE=EchidnaClaw Control Plane
VITE_RUNTIME_MODE=local-minimal

# Shared-cloud dependencies
# Required when ECHIDNA_RUNTIME_MODE=shared-cloud or cloud-deployed
AZURE_CLIENT_ID=
ECHIDNA_OPERATOR_OBJECT_ID=
ECHIDNA_TRUSTED_USER_OBJECT_IDS=
ECHIDNA_COSMOS_DB_ENDPOINT=
ECHIDNA_COSMOS_DB_DATABASE_NAME=
ECHIDNA_COSMOS_DB_CREDENTIAL_SCOPE=
ECHIDNA_BLOB_STORAGE_ACCOUNT_URL=
ECHIDNA_BLOB_STORAGE_UPLOADS_CONTAINER=
ECHIDNA_BLOB_STORAGE_ARTIFACTS_CONTAINER=
ECHIDNA_KEY_VAULT_URI=
ECHIDNA_KEY_VAULT_KEY_ID=
ECHIDNA_FOUNDRY_PROJECT_NAME=
ECHIDNA_FOUNDRY_PROJECT_ENDPOINT=
ECHIDNA_FOUNDRY_DEFAULT_DEPLOYMENT_NAME=
ECHIDNA_FOUNDRY_MEMORY_CHAT_DEPLOYMENT_NAME=
ECHIDNA_FOUNDRY_MEMORY_EMBEDDING_DEPLOYMENT_NAME=
ECHIDNA_MONITOR_CONNECTION_STRING=

# Deployment and image packaging
ECHIDNA_CONTAINER_REGISTRY_NAME=
ECHIDNA_CONTAINER_REGISTRY_LOGIN_SERVER=
ECHIDNA_IMAGE_TAG=local
ECHIDNA_IMAGE_REPOSITORY_API=echidna-claw/api
ECHIDNA_IMAGE_REPOSITORY_HANDS=echidna-claw/hands
ECHIDNA_IMAGE_REPOSITORY_SANDBOX=echidna-claw/sandbox
ECHIDNA_IMAGE_REPOSITORY_WEB=echidna-claw/web
